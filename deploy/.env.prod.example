# CB-MDTM — Ankara prod .env sablonu
# ==================================
# Bu dosya REFERANSTIR; gercek degerler backend/.env icine yazilir.
# backend/.env .gitignore'da ve chmod 600 olmali.
#
# Docker Compose bu dosyayi deploy/.env uzerinden okur:
#   ln -sf /opt/matisse/backend/.env /opt/matisse/deploy/.env

# ─── Veritabani ──────────────────────────────────────────────────────────
# Alembic/psycopg2 icin duz URL. config.py bunu asyncpg'ye cevirir.
DATABASE_URL=postgresql://postgres:DEGISTIR_GUCLU_SIFRE@localhost:5432/cbmdtm

# Docker Compose postgres servisi de bu sifreyi kullanir (ayni deger!)
POSTGRES_PASSWORD=DEGISTIR_GUCLU_SIFRE

# ─── Keycloak ────────────────────────────────────────────────────────────
# Gecici bootstrap admin — STEP 27'de kalici admin acilip bu SILINECEK
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=DEGISTIR_GUCLU_SIFRE

# DNS yoksa LAN IP yaz, TLS sonrasi matisse.deftr.com
KC_HOSTNAME=matisse.deftr.com

# Backend JWT dogrulamasi bu issuer'a bakar.
# HTTP asamasi:  http://<LAN_IP>/auth/realms/cbmdtm
# TLS sonrasi:   https://matisse.deftr.com/auth/realms/cbmdtm
KEYCLOAK_ISSUER=https://matisse.deftr.com/auth/realms/cbmdtm
KEYCLOAK_CLIENT_ID=cbmdtm-frontend

# Keycloak 26 access token'inda aud claim'i "account" gelir.
# STEP 33'te audience mapper eklenip true yapilacak.
KEYCLOAK_VERIFY_AUDIENCE=false

# ─── CORS ────────────────────────────────────────────────────────────────
# Frontend ve API ayni origin'de (nginx path routing) -> CORS onemsiz.
# Yine de acikca tanimli olsun.
CORS_ORIGINS=https://matisse.deftr.com

# ─── MQTT ────────────────────────────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=factory/motor
MQTT_QOS=1
# Faz 3'te 8883 + TLS + kullanici/parola:
# MQTT_USERNAME=
# MQTT_PASSWORD=

# ─── OTOKAR Infinite Uptime ──────────────────────────────────────────────
# ⚠️ Sifre rotate edilirse BU DOSYA DA guncellenmeli ve tek istekle
#    dogrulanmali. (28 Tem: rotate edildi, .env guncellenmedi,
#    bridge 7 gun boyunca sessizce 401 aldi.)
OTOKAR_IU_USERNAME=serhatkahraman@deftr.com
OTOKAR_IU_PASSWORD=DEGISTIR
OTOKAR_IU_PLANT_ID=1716
OTOKAR_IU_BASIC_POLL_SEC=60
OTOKAR_IU_COMPUTED_POLL_SEC=1800
OTOKAR_IU_LOOKBACK_MIN=60

# ─── KPI ─────────────────────────────────────────────────────────────────
KPI_WINDOW_HOURS=1
