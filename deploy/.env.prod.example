# CB-MDTM — Ankara prod .env sablonu
# ==================================
# Bu dosya REFERANSTIR; gercek degerler backend/.env icine yazilir.
# backend/.env .gitignore'da ve chmod 600 olmali.
#
# Docker Compose bu dosyayi deploy/.env uzerinden okur:
#   ln -sf /opt/matisse/backend/.env /opt/matisse/deploy/.env
#
# ========================================================================
#   UC AYRI TUKETICI VAR — hangisinin neyi okudugu asagida isaretlidir.
#   Bir degiskeni degistirirken TUM tuketicilerin guncellendiginden emin
#   ol. (30 Tem kurulumunda DB_PASSWORD atlandi, backend eski varsayilan
#   sifreyle baglanmaya calisti.)
# ========================================================================


# ═══════════════════════════════════════════════════════════════════════
# GRUP 1 — BACKEND OKUR  (app/core/config.py · Settings sinifi)
# ═══════════════════════════════════════════════════════════════════════

# --- Uygulama ---
APP_ENV=production

# --- Veritabani ---
# ⚠ config.py DATABASE_URL'i OKUMAZ. Asagidaki DB_* alanlarini okur ve
#   settings.database_url property'sini bunlardan uretir:
#     postgresql+asyncpg://{DB_USER}:{DB_PASSWORD}@{DB_HOST}:{DB_PORT}/{DB_NAME}
#   DB_PASSWORD verilmezse config.py'deki varsayilan kullanilir — bu
#   varsayilan dev sifresidir ve prod'da MUTLAKA ezilmelidir.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cbmdtm
DB_USER=postgres
DB_PASSWORD=DEGISTIR_GUCLU_SIFRE

# --- Keycloak / JWT ---
# ISSUER: token'daki iss claim'i ile birebir eslesmeli.
#   TLS oncesi : http://<LAN_IP>/auth/realms/cbmdtm
#   TLS sonrasi: https://matisse.deftr.com/auth/realms/cbmdtm
KEYCLOAK_ISSUER=https://matisse.deftr.com/auth/realms/cbmdtm

# ⚠ JWKS: backend anahtarlari nginx'e UGRAMADAN dogrudan Keycloak'tan ceker.
#   Bu yuzden localhost:8080 kullanilir (self-signed sertifika dogrulama
#   sorunu yasanmasin diye HTTP).
#   /auth ONEMLI: Keycloak KC_HTTP_RELATIVE_PATH=/auth ile calisiyor;
#   bu yol olmadan 404 doner ve HICBIR token dogrulanamaz.
#   config.py'deki varsayilan /auth ICERMEZ — burada acikca verilmeli.
KEYCLOAK_JWKS_URL=http://localhost:8080/auth/realms/cbmdtm/protocol/openid-connect/certs

KEYCLOAK_CLIENT_ID=cbmdtm-frontend
KEYCLOAK_AUDIENCE=account
# Keycloak 26 access token'inda aud claim'i "account" gelir.
# STEP 33'te audience mapper eklenip true yapilacak.
KEYCLOAK_VERIFY_AUDIENCE=false
JWKS_CACHE_TTL_SECONDS=3600

# --- CORS ---
# ⚠ Dogru ad CORS_ORIGINS_RAW'dir. config.py bunu virgulle ayirip
#   CORS_ORIGINS property'si olarak expose eder. "CORS_ORIGINS=" yazmak
#   YOK SAYILIR (extra="ignore") ve varsayilan localhost kalir.
CORS_ORIGINS_RAW=https://matisse.deftr.com

# --- SSE / KPI / Rate limit ---
SSE_KEEPALIVE_SECONDS=15
KPI_WINDOW_HOURS=1
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_ME=30/minute

# Rate limit sayac deposu (S1.4).
# Bos veya memory:// ise surec ici bellek kullanilir -> uvicorn --workers N
# ile efektif limit N katina cikar (uretimde --workers 2, yani 120/dk).
# Redis ortak sayac saglar. Erisilemezse backend in-memory'ye duser ve
# uyari loglar; servis calismaya devam eder.
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0


# ═══════════════════════════════════════════════════════════════════════
# GRUP 2 — ALEMBIC ve SEED OKUR  (migrations/env.py · tools/seed*.py)
# ═══════════════════════════════════════════════════════════════════════

# ⚠ Alembic psycopg2 kullanir (asyncpg degil) ve DUZ URL ister.
#   Backend'in DB_* alanlariyla AYNI sifreyi tasimali — iki yerde birden
#   guncellenmezse Alembic bir sifreyle, FastAPI baskasiyla baglanir.
#   seed.py da bu degiskeni ortamdan okur:
#     export DATABASE_URL=$(grep '^DATABASE_URL=' ../.env | cut -d'=' -f2-)
DATABASE_URL=postgresql://postgres:DEGISTIR_GUCLU_SIFRE@localhost:5432/cbmdtm


# ═══════════════════════════════════════════════════════════════════════
# GRUP 3 — DOCKER COMPOSE OKUR  (deploy/docker-compose.yml)
# ═══════════════════════════════════════════════════════════════════════
# Bu degiskenler config.py'de TANIMLI DEGIL; Settings onlari yok sayar
# (model_config extra="ignore"). Yalnizca Compose tuketir.

# --- PostgreSQL konteyneri ---
# ⚠ DB_PASSWORD ve DATABASE_URL icindeki sifre ile AYNI olmali.
#   Farkli olursa: PG bir sifreyle kurulur, uygulama baskasiyla baglanmaya
#   calisir. Volume olustuktan SONRA degistirmek icin volume silmek gerekir.
POSTGRES_PASSWORD=DEGISTIR_GUCLU_SIFRE

# --- Keycloak konteyneri ---
# Gecici bootstrap admin — STEP 27'de kalici admin acilip bu SILINECEK.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=DEGISTIR_GUCLU_SIFRE

# ⚠ KC_HOSTNAME'e TAM URL verilirse Keycloak YOLU DA oradan alir ve
#   KC_HTTP_RELATIVE_PATH=/auth ayarini EZER. Sonuc: issuer /auth'suz
#   uretilir ve backend'in bekledigi issuer ile uyusmaz.
#   Bu yuzden yol (/auth) MUTLAKA dahil edilmeli.
#     TLS oncesi : http://<LAN_IP>/auth
#     TLS sonrasi: https://matisse.deftr.com/auth
KC_HOSTNAME=https://matisse.deftr.com/auth


# ═══════════════════════════════════════════════════════════════════════
# GRUP 4 — BRIDGE ve WORKER OKUR  (tools/otokar_iu_bridge.py, ingest/)
# ═══════════════════════════════════════════════════════════════════════

# --- MQTT ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=factory/motor
MQTT_QOS=1
# S1.5'te anonim erisim kapatilinca doldurulacak:
# MQTT_USERNAME=
# MQTT_PASSWORD=

# --- OTOKAR Infinite Uptime ---
# ⚠ KIMLIK BILGISI DEGISIMI IKI ADIMLI BIR ISLEMDIR:
#   (1) kaynakta degistir  (2) BU DOSYAYI guncelle + tek istekle dogrula.
#   28 Tem: sifre 21 Tem'de rotate edildi, .env guncellenmedi; bridge
#   7 gun boyunca sessizce 401 aldi ve bu fark edilmedi.
OTOKAR_IU_USERNAME=serhatkahraman@deftr.com
OTOKAR_IU_PASSWORD=DEGISTIR
OTOKAR_IU_PLANT_ID=1716
OTOKAR_IU_BASIC_POLL_SEC=60
OTOKAR_IU_COMPUTED_POLL_SEC=1800
OTOKAR_IU_LOOKBACK_MIN=60