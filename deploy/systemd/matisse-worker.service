# CB-MDTM — MQTT ingest worker
# Kurulum:
#   sudo cp /opt/matisse/deploy/systemd/matisse-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now matisse-worker

[Unit]
Description=CB-MDTM MQTT ingest worker (matisse-worker)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

# StartLimit* [Unit] bolumune aittir; [Service] icinde
# 'Unknown key name' uyarisiyla yok sayilir.
StartLimitBurst=5
StartLimitIntervalSec=120
[Service]
Type=exec
User=matisse
Group=matisse
WorkingDirectory=/opt/matisse/backend
EnvironmentFile=/opt/matisse/backend/.env

# ONEMLI: worker resolver cache'ini BASLANGICTA BIR KEZ yukler.
# Yeni/degisen signal_code sonrasi mutlaka restart:
#   sudo systemctl restart matisse-worker
ExecStart=/opt/matisse/backend/.venv/bin/python -m app.ingest.mqtt_worker

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=true asyncpg'yi kirar: her baglantida
# ~/.postgresql/postgresql.key varligini kontrol eder ve /home
# erisilemezse PermissionError firlatir. tmpfs ile /home bos bir
# tmpfs olarak gorunur -> exists() False doner, baglanti kurulur.
ProtectHome=tmpfs
ReadWritePaths=/opt/matisse

StandardOutput=journal
StandardError=journal
SyslogIdentifier=matisse-worker

[Install]
WantedBy=multi-user.target
