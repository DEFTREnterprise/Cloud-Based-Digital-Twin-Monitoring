# Git LFS — buyuk binary dosyalar (KORUNMALI)
*.stl filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text

# Repo geneli: metin dosyalari otomatik algilanir
* text=auto

# Linux'ta calisacak dosyalar HER ZAMAN LF olmali.
# CRLF ile systemd unit'lerdeki satir devami (\) kirilir -> servis baslamaz.
*.service   text eol=lf
*.conf      text eol=lf
*.sh        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
deploy/**   text eol=lf