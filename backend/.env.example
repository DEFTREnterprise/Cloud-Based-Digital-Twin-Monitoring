DATABASE_URL=postgresql://postgres:DEFTRServer1@localhost:5432/cbmdtm

# --- OTOKAR API (1.4 — kontrat gelince doldurulacak) ---
OTOKAR_MODE=mock          # mock | pull | push   (kontrat gelince pull veya push)
OTOKAR_BASE_URL=          # pull modunda REST endpoint, or. https://otokar.example/api/telemetry
OTOKAR_API_KEY=           # auth: API key (veya OAuth2 token)
OTOKAR_POLL_INTERVAL=1.0  # pull modunda saniyede kac kez cekilecek
OTOKAR_MQTT_TOPIC=otokar/+/telemetry   # push modunda dinlenecek topic
