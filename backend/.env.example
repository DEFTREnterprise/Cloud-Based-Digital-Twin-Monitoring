$env = @'
# CB-MDTM — .env sablonu
# Gercek degerler backend/.env icinde (gitignore'da, chmod 600).
# Prod degerleri icin: deploy/.env.prod.example

APP_ENV=development

# --- Veritabani ---
# Alembic/psycopg2 duz URL kullanir; config.py bunu asyncpg'ye cevirir.
DATABASE_URL=postgresql://postgres:DEGISTIR@localhost:5432/cbmdtm
POSTGRES_PASSWORD=DEGISTIR

# --- Keycloak ---
KEYCLOAK_ISSUER=http://localhost:8080/realms/cbmdtm
KEYCLOAK_CLIENT_ID=cbmdtm-frontend
# Keycloak 26 access token'inda aud claim'i "account" gelir (STEP 33'te true)
KEYCLOAK_VERIFY_AUDIENCE=false

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- MQTT ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=factory/motor
MQTT_QOS=1

# --- OTOKAR Infinite Uptime ---
# UYARI: sifre rotate edilirse BU DOSYA DA guncellenmeli ve tek istekle
# dogrulanmali (28 Tem: rotate edildi, .env guncellenmedi, bridge 7 gun
# boyunca sessizce 401 aldi).
OTOKAR_IU_USERNAME=
OTOKAR_IU_PASSWORD=DEGISTIR
OTOKAR_IU_PLANT_ID=1716
OTOKAR_IU_BASIC_POLL_SEC=60
OTOKAR_IU_COMPUTED_POLL_SEC=1800
OTOKAR_IU_LOOKBACK_MIN=60

# --- KPI ---
KPI_WINDOW_HOURS=1
'@

[System.IO.File]::WriteAllText(
    "$PWD\backend\.env.example",
    $env.Replace("`r`n","`n"),
    (New-Object System.Text.UTF8Encoding $false)
)

Get-Content backend\.env.example | Select-Object -First 8